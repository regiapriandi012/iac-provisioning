pipeline {
    agent any

    // Define parameters for destroying specific cluster
    parameters {
        string(name: 'CLUSTER_NAME', defaultValue: 'k8s-cluster', description: 'Name of the Kubernetes cluster to destroy')
        string(name: 'TERRAFORM_STATE_FILE', defaultValue: '', description: 'Optional: Path to specific terraform state file')
        choice(name: 'PROXMOX_NODE', choices: ['thinkcentre', 'proxmox'], description: 'Proxmox node where cluster is deployed')
        booleanParam(name: 'FORCE_DESTROY', defaultValue: false, description: 'Force destroy even if cluster is not in ready/failed state')
        booleanParam(name: 'SKIP_CONFIRMATION', defaultValue: false, description: 'Skip manual confirmation (use with caution)')
    }

    environment {
        TERRAFORM_DIR = 'terraform'
        CONFIG_FILE = 'config/environment.conf'
        
        // Use parameters for terraform variables
        TF_VAR_cluster_name = "${params.CLUSTER_NAME}"
        TF_VAR_proxmox_node = "${params.PROXMOX_NODE}"
    }
    
    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Validate Destroy Parameters') {
            steps {
                script {
                    echo """
=== CLUSTER DESTRUCTION STARTED ===
Cluster Name: ${params.CLUSTER_NAME}
Proxmox Node: ${params.PROXMOX_NODE}
Force Destroy: ${params.FORCE_DESTROY}
Skip Confirmation: ${params.SKIP_CONFIRMATION}
===================================
"""
                    
                    // Validate cluster name is provided
                    if (!params.CLUSTER_NAME || params.CLUSTER_NAME.trim() == '') {
                        error("CLUSTER_NAME parameter is required for destruction")
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    // Load configuration values using simple file reading
                    def configContent = readFile(CONFIG_FILE)
                    def configProps = [:]
                    
                    configContent.split('\n').each { line ->
                        line = line.trim()
                        if (line && !line.startsWith('#') && line.contains('=')) {
                            def parts = line.split('=', 2)
                            configProps[parts[0].trim()] = parts[1].trim()
                        }
                    }
                    
                    def gitUrl = configProps.GIT_REPOSITORY_URL ?: 'https://gitlab.labngoprek.my.id/root/iac-provision'
                    def gitBranch = configProps.GIT_BRANCH ?: 'main'
                    def gitCredentials = configProps.GIT_CREDENTIALS_ID ?: 'gitlab-credential'
                    
                    git branch: gitBranch,
                        credentialsId: gitCredentials,
                        url: gitUrl
                }
            }
        }
        
        stage('Setup Environment') {
            steps {
                script {
                    // Load configuration
                    def configContent = readFile(CONFIG_FILE)
                    def configProps = [:]
                    
                    configContent.split('\n').each { line ->
                        line = line.trim()
                        if (line && !line.startsWith('#') && line.contains('=')) {
                            def parts = line.split('=', 2)
                            configProps[parts[0].trim()] = parts[1].trim()
                        }
                    }
                    
                    env.PROXMOX_CREDENTIALS_PREFIX = configProps.PROXMOX_CREDENTIALS_PREFIX ?: 'proxmox'
                    env.SLACK_WEBHOOK_CREDENTIAL_ID = configProps.SLACK_WEBHOOK_CREDENTIAL_ID ?: 'slack-webhook-url'
                    
                    sh './scripts/setup_environment.sh'
                    
                    // Set environment variables for subsequent stages
                    env.PATH = "${WORKSPACE}/venv/bin:${env.PATH}"
                    env.VIRTUAL_ENV = "${WORKSPACE}/venv"
                }
            }
        }
        
        stage('Pre-destroy Validation') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-url", variable: 'TF_VAR_pm_api_url'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-id", variable: 'TF_VAR_pm_api_token_id'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-secret", variable: 'TF_VAR_pm_api_token_secret')
                    ]) {
                        script {
                            // Initialize terraform to read state
                            sh 'terraform init -upgrade=false'
                            
                            // Check if there are resources to destroy
                            def planOutput = sh(
                                script: 'terraform plan -destroy -detailed-exitcode -var cluster_name="${TF_VAR_cluster_name}" || echo "exit_code=$?"',
                                returnStdout: true
                            ).trim()
                            
                            echo "Terraform plan output: ${planOutput}"
                            
                            // Show what will be destroyed
                            echo """
=== RESOURCES TO BE DESTROYED ===
The following resources for cluster '${params.CLUSTER_NAME}' will be destroyed:
"""
                            sh '''
                                terraform show -json terraform.tfstate 2>/dev/null | python3 -c "
import json, sys
try:
    state = json.load(sys.stdin)
    resources = state.get('values', {}).get('root_module', {}).get('resources', [])
    cluster_resources = [r for r in resources if '${TF_VAR_cluster_name}' in r.get('values', {}).get('name', '')]
    print(f'Found {len(cluster_resources)} resources for cluster ${TF_VAR_cluster_name}:')
    for r in cluster_resources:
        print(f'  - {r[\"type\"]}.{r[\"name\"]}: {r[\"values\"][\"name\"]}')
except:
    print('No terraform state found or unable to parse')
" || echo "No resources found or unable to read state"
                            '''
                        }
                    }
                }
            }
        }

        stage('Manual Confirmation') {
            when {
                not { expression { params.SKIP_CONFIRMATION == true } }
            }
            steps {
                script {
                    try {
                        timeout(time: 5, unit: 'MINUTES') {
                            input message: """
Are you sure you want to DESTROY cluster '${params.CLUSTER_NAME}'?

⚠️  WARNING: This action is IRREVERSIBLE!
⚠️  All VMs and associated resources will be permanently deleted!
⚠️  All data on the cluster will be lost!

Click 'Proceed' to continue with destruction or 'Abort' to cancel.
""", 
                                ok: 'Proceed with DESTRUCTION',
                                submitterParameter: 'APPROVER'
                        }
                        echo "Destruction approved by: ${APPROVER}"
                    } catch (Exception e) {
                        echo "Destruction cancelled or timed out"
                        error("Cluster destruction cancelled")
                    }
                }
            }
        }
        
        stage('Terraform Destroy') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-url", variable: 'TF_VAR_pm_api_url'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-id", variable: 'TF_VAR_pm_api_token_id'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-secret", variable: 'TF_VAR_pm_api_token_secret')
                    ]) {
                        script {
                            def startTime = System.currentTimeMillis()
                            
                            echo "🔥 Starting infrastructure destruction for cluster: ${params.CLUSTER_NAME}"
                            
                            // Execute terraform destroy
                            def destroyResult = sh(
                                script: '''
                                    terraform destroy \
                                        -auto-approve \
                                        -var cluster_name="${TF_VAR_cluster_name}" \
                                        -var proxmox_node="${TF_VAR_proxmox_node}" \
                                        2>&1 | tee destroy.log
                                    echo "DESTROY_EXIT_CODE=${PIPESTATUS[0]}" >> destroy.log
                                ''',
                                returnStatus: true
                            )
                            
                            def duration = ((System.currentTimeMillis() - startTime) / 1000).intValue()
                            
                            if (destroyResult == 0) {
                                echo "✅ Infrastructure destroyed successfully in ${duration}s"
                                
                                // Clean up terraform files
                                sh '''
                                    rm -f terraform.tfstate terraform.tfstate.backup
                                    rm -f tfplan destroy.log
                                '''
                                
                            } else {
                                echo "❌ Terraform destroy failed with exit code: ${destroyResult}"
                                
                                // Show destroy log for debugging
                                sh 'cat destroy.log || echo "No destroy log available"'
                                
                                error("Failed to destroy infrastructure")
                            }
                        }
                    }
                }
            }
        }
        
        stage('Notify Django') {
            steps {
                script {
                    try {
                        echo "Notifying Django about cluster destruction..."
                        
                        // Send destruction notification to Django webhook
                        sh """
                            cd ${WORKSPACE}
                            python3 -c "
import requests
import json
import os

webhook_url = 'https://labngoprek.my.id/webhook/jenkins/'
payload = {
    'name': '${params.CLUSTER_NAME}',
    'build': {
        'number': int('${BUILD_NUMBER}'),
        'status': 'success',
        'full_url': '${BUILD_URL}'
    },
    'action': 'destroy',
    'cluster_name': '${params.CLUSTER_NAME}'
}

try:
    response = requests.post(webhook_url, json=payload, timeout=30)
    if response.status_code == 200:
        print('✅ Successfully notified Django about destruction')
    else:
        print(f'⚠️ Django webhook returned {response.status_code}: {response.text}')
except Exception as e:
    print(f'⚠️ Failed to notify Django: {e}')
"
                        """
                        
                    } catch (Exception e) {
                        echo "Warning: Failed to notify Django about destruction: ${e.getMessage()}"
                        // Continue even if Django notification fails
                    }
                }
            }
        }
        
        stage('Notify Slack') {
            steps {
                script {
                    try {
                        withCredentials([string(credentialsId: env.SLACK_WEBHOOK_CREDENTIAL_ID, variable: 'SLACK_WEBHOOK_URL')]) {
                            def buildDuration = currentBuild.durationString.replace(' and counting', '')
                            
                            sh """
                                curl -X POST -H 'Content-type: application/json' \
                                --data '{
                                    "text": "🔥 *Cluster Destroyed*",
                                    "attachments": [
                                        {
                                            "color": "danger",
                                            "fields": [
                                                {
                                                    "title": "Cluster Name",
                                                    "value": "${params.CLUSTER_NAME}",
                                                    "short": true
                                                },
                                                {
                                                    "title": "Proxmox Node", 
                                                    "value": "${params.PROXMOX_NODE}",
                                                    "short": true
                                                },
                                                {
                                                    "title": "Duration",
                                                    "value": "${buildDuration}",
                                                    "short": true
                                                },
                                                {
                                                    "title": "Status",
                                                    "value": "✅ Successfully Destroyed",
                                                    "short": true
                                                }
                                            ]
                                        }
                                    ]
                                }' \
                                "\${SLACK_WEBHOOK_URL}"
                            """
                        }
                    } catch (Exception e) {
                        echo "Warning: Failed to send Slack notification: ${e.getMessage()}"
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                // Archive destruction logs
                archiveArtifacts artifacts: "${TERRAFORM_DIR}/destroy.log", allowEmptyArchive: true
                
                def totalDuration = currentBuild.durationString.replace(' and counting', '')
                echo """
Destruction Summary
===================
Total Duration: ${totalDuration}
Cluster: ${params.CLUSTER_NAME}
"""
            }
        }
        
        success {
            script {
                def successMessage = """
==================== DESTRUCTION SUCCESS ====================
Cluster '${params.CLUSTER_NAME}' has been successfully destroyed!

What was destroyed:
- All VMs associated with cluster '${params.CLUSTER_NAME}'
- Network configurations
- Storage allocations
- Terraform state cleaned up

⚠️  IMPORTANT: All data has been permanently lost!

Next steps:
- Cluster is now completely removed from infrastructure
- You can create a new cluster with the same name if needed
- Django application has been notified of the destruction
===========================================================
"""
                echo successMessage
            }
        }
        
        failure {
            echo """
==================== DESTRUCTION FAILURE ====================
Failed to destroy cluster '${params.CLUSTER_NAME}'!

Common troubleshooting steps:
1. Check if VMs are still running in Proxmox
2. Verify terraform state consistency
3. Check network connectivity to Proxmox
4. Review destruction logs for specific errors
5. May need manual cleanup in Proxmox interface

IMPORTANT: Some resources may still exist and need manual cleanup!
=============================================================
"""
        }
        
        cleanup {
            sh '''
                # Cleanup temporary files
                rm -f ${TERRAFORM_DIR}/destroy.log || true
                find . -name "*.retry" -delete || true
            '''
        }
    }
}
pipeline {
    agent any

    // Define parameters for destroying specific cluster
    parameters {
        string(name: 'CLUSTER_NAME', defaultValue: 'k8s-cluster', description: 'Name of the Kubernetes cluster to destroy')
        string(name: 'TERRAFORM_STATE_FILE', defaultValue: '', description: 'Optional: Path to specific terraform state file')
        choice(name: 'PROXMOX_NODE', choices: ['thinkcentre', 'proxmox'], description: 'Proxmox node where cluster is deployed')
        booleanParam(name: 'FORCE_DESTROY', defaultValue: false, description: 'Force destroy even if cluster is not in ready/failed state')
        booleanParam(name: 'SKIP_CONFIRMATION', defaultValue: true, description: 'Legacy parameter - manual confirmation has been removed for auto-destroy')
        
        // VM ID parameters for direct Proxmox destruction
        string(name: 'ALL_VMIDS', defaultValue: '', description: 'Comma-separated list of all VM IDs to destroy (e.g., "100,101,102")')
        string(name: 'MASTER_VMIDS', defaultValue: '', description: 'Comma-separated list of master VM IDs')
        string(name: 'WORKER_VMIDS', defaultValue: '', description: 'Comma-separated list of worker VM IDs')
        string(name: 'VM_COUNT', defaultValue: '', description: 'Total number of VMs to destroy')
        string(name: 'MASTER_HOSTNAMES', defaultValue: '', description: 'Comma-separated list of master hostnames')
        string(name: 'WORKER_HOSTNAMES', defaultValue: '', description: 'Comma-separated list of worker hostnames')
    }

    environment {
        TERRAFORM_DIR = 'terraform'
        CONFIG_FILE = 'config/environment.conf'
    }
    
    options {
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Validate Destroy Parameters') {
            steps {
                script {
                    echo """
=== CLUSTER DESTRUCTION STARTED ===
Cluster Name: ${params.CLUSTER_NAME}
Proxmox Node: ${params.PROXMOX_NODE}
Force Destroy: ${params.FORCE_DESTROY}
Skip Confirmation: ${params.SKIP_CONFIRMATION}

=== VM ID METADATA ===
All VM IDs: ${params.ALL_VMIDS ?: 'Not provided - will use terraform state'}
Master VM IDs: ${params.MASTER_VMIDS ?: 'Not provided'}
Worker VM IDs: ${params.WORKER_VMIDS ?: 'Not provided'}
VM Count: ${params.VM_COUNT ?: 'Unknown'}
Master Hostnames: ${params.MASTER_HOSTNAMES ?: 'Not provided'}
Worker Hostnames: ${params.WORKER_HOSTNAMES ?: 'Not provided'}

Destruction Method: ${params.ALL_VMIDS ? 'Direct VM ID destruction' : 'Terraform state-based destruction'}
===================================
"""
                    
                    // Validate cluster name is provided
                    if (!params.CLUSTER_NAME || params.CLUSTER_NAME.trim() == '') {
                        error("CLUSTER_NAME parameter is required for destruction")
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    // Load configuration values using simple file reading
                    def configContent = readFile(CONFIG_FILE)
                    def configProps = [:]
                    
                    configContent.split('\n').each { line ->
                        line = line.trim()
                        if (line && !line.startsWith('#') && line.contains('=')) {
                            def parts = line.split('=', 2)
                            configProps[parts[0].trim()] = parts[1].trim()
                        }
                    }
                    
                    def gitUrl = configProps.GIT_REPOSITORY_URL ?: 'https://gitlab.labngoprek.my.id/root/iac-provision'
                    def gitBranch = configProps.GIT_BRANCH ?: 'main'
                    def gitCredentials = configProps.GIT_CREDENTIALS_ID ?: 'gitlab-credential'
                    
                    git branch: gitBranch,
                        credentialsId: gitCredentials,
                        url: gitUrl
                }
            }
        }
        
        stage('Setup Environment') {
            steps {
                script {
                    // Load configuration
                    def configContent = readFile(CONFIG_FILE)
                    def configProps = [:]
                    
                    configContent.split('\n').each { line ->
                        line = line.trim()
                        if (line && !line.startsWith('#') && line.contains('=')) {
                            def parts = line.split('=', 2)
                            configProps[parts[0].trim()] = parts[1].trim()
                        }
                    }
                    
                    env.PROXMOX_CREDENTIALS_PREFIX = configProps.PROXMOX_CREDENTIALS_PREFIX ?: 'proxmox'
                    env.SLACK_WEBHOOK_CREDENTIAL_ID = configProps.SLACK_WEBHOOK_CREDENTIAL_ID ?: 'slack-webhook-url'
                    
                    sh './scripts/setup_environment.sh'
                    
                    // Set environment variables for subsequent stages
                    env.PATH = "${WORKSPACE}/venv/bin:${env.PATH}"
                    env.VIRTUAL_ENV = "${WORKSPACE}/venv"
                }
            }
        }
        
        stage('Pre-destroy Validation') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-url", variable: 'TF_VAR_pm_api_url'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-id", variable: 'TF_VAR_pm_api_token_id'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-secret", variable: 'TF_VAR_pm_api_token_secret')
                    ]) {
                        script {
                            // Initialize terraform to read state
                            sh 'terraform init -upgrade=false'
                            
                            // Check if there are resources to destroy (no cluster_name variable needed for destroy)
                            def planOutput = sh(
                                script: 'terraform plan -destroy -detailed-exitcode || echo "exit_code=$?"',
                                returnStdout: true
                            ).trim()
                            
                            echo "Terraform plan output: ${planOutput}"
                            
                            // Show what will be destroyed
                            echo """
=== RESOURCES TO BE DESTROYED ===
The following resources for cluster '${params.CLUSTER_NAME}' will be destroyed:
"""
                            sh '''
                                terraform show -json terraform.tfstate 2>/dev/null | python3 -c "
import json, sys
try:
    state = json.load(sys.stdin)
    resources = state.get('values', {}).get('root_module', {}).get('resources', [])
    cluster_resources = [r for r in resources if '${TF_VAR_cluster_name}' in r.get('values', {}).get('name', '')]
    print(f'Found {len(cluster_resources)} resources for cluster ${TF_VAR_cluster_name}:')
    for r in cluster_resources:
        print(f'  - {r[\"type\"]}.{r[\"name\"]}: {r[\"values\"][\"name\"]}')
except:
    print('No terraform state found or unable to parse')
" || echo "No resources found or unable to read state"
                            '''
                        }
                    }
                }
            }
        }

        stage('Auto-Destroy Confirmation') {
            steps {
                script {
                    echo """
=== AUTOMATIC DESTRUCTION INITIATED ===
Cluster: ${params.CLUSTER_NAME}
Proxmox Node: ${params.PROXMOX_NODE}
Triggered by: Customer request or auto-expiry (3-hour timeout)
Skip Confirmation: ${params.SKIP_CONFIRMATION}

WARNING: This action is IRREVERSIBLE!
WARNING: All VMs and associated resources will be permanently deleted!
WARNING: All data on the cluster will be lost!

Proceeding with automatic destruction...
======================================
"""
                }
            }
        }
        
        stage('Direct VM Destruction') {
            when {
                expression { return params.ALL_VMIDS != null && params.ALL_VMIDS != '' }
            }
            steps {
                script {
                    echo "Using direct VM destruction with VM IDs: ${params.ALL_VMIDS}"
                    
                    withCredentials([
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-url", variable: 'PROXMOX_API_URL'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-id", variable: 'PROXMOX_TOKEN_ID'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-secret", variable: 'PROXMOX_TOKEN_SECRET')
                    ]) {
                        def vmIds = params.ALL_VMIDS.split(',')
                        def destroyedVMs = []
                        def failedVMs = []
                        
                        echo "Starting direct VM destruction for ${vmIds.size()} VMs..."
                        
                        vmIds.each { vmId ->
                            vmId = vmId.trim()
                            if (vmId) {
                                try {
                                    echo "Destroying VM ${vmId} on node ${params.PROXMOX_NODE}..."
                                    
                                    // Stop VM first (ignore errors if already stopped)
                                    def stopResult = sh(
                                        script: """
                                            curl -k -X POST \\
                                                -H "Authorization: PVEAPIToken=${PROXMOX_TOKEN_ID}=${PROXMOX_TOKEN_SECRET}" \\
                                                "https://172.16.20.115:8006/api2/json/nodes/${params.PROXMOX_NODE}/qemu/${vmId}/status/stop" \\
                                                -w "%{http_code}" -o /tmp/vm_stop_${vmId}.json -s
                                        """,
                                        returnStdout: true
                                    ).trim()
                                    
                                    // Wait a moment for VM to stop
                                    sleep(3)
                                    
                                    // Check if VM exists first, then delete if it exists
                                    def checkResult = sh(
                                        script: """
                                            # Check if VM exists before attempting deletion
                                            PROXMOX_HOST="172.16.20.115"
                                            
                                            # Method 1: Check via SSH if available
                                            if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 root@\${PROXMOX_HOST} "pvesh get /nodes/${params.PROXMOX_NODE}/qemu/${vmId}/status/current" 2>/dev/null; then
                                                echo "EXISTS_SSH"
                                            else
                                                # Method 2: Check via API
                                                CHECK_RESULT=\$(curl -k -X GET \\
                                                    -H "Authorization: PVEAPIToken=${PROXMOX_TOKEN_ID}=${PROXMOX_TOKEN_SECRET}" \\
                                                    "https://172.16.20.115:8006/api2/json/nodes/${params.PROXMOX_NODE}/qemu/${vmId}/status/current" \\
                                                    -w "%{http_code}" -o /tmp/vm_check_${vmId}.json -s)
                                                
                                                if [ "\$CHECK_RESULT" = "200" ]; then
                                                    echo "EXISTS_API"
                                                elif [ "\$CHECK_RESULT" = "404" ] || [ "\$CHECK_RESULT" = "500" ]; then
                                                    echo "NOT_EXISTS"
                                                else
                                                    echo "CHECK_FAILED_\$CHECK_RESULT"
                                                fi
                                            fi
                                        """,
                                        returnStdout: true
                                    ).trim()
                                    
                                    if (checkResult == "NOT_EXISTS") {
                                        echo "✅ VM ${vmId} doesn't exist - already destroyed or never created"
                                        destroyedVMs.add(vmId)
                                    } else if (checkResult.startsWith("EXISTS_")) {
                                        echo "🔥 VM ${vmId} exists, proceeding with destruction..."
                                        
                                        // Delete VM - try multiple methods for compatibility
                                        def deleteResult = sh(
                                            script: """
                                                # Method 1: Try using pvesh via SSH (most reliable)
                                                PROXMOX_HOST="172.16.20.115"
                                                
                                                # Try SSH with pvesh delete (if SSH is available)
                                                if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 root@\${PROXMOX_HOST} "pvesh delete /nodes/${params.PROXMOX_NODE}/qemu/${vmId} --purge 1" 2>/dev/null; then
                                                    echo "200"
                                                else
                                                    # Method 2: Use correct Proxmox API DELETE endpoint
                                                    TASK_RESULT=\$(curl -k -X DELETE \\
                                                        -H "Authorization: PVEAPIToken=${PROXMOX_TOKEN_ID}=${PROXMOX_TOKEN_SECRET}" \\
                                                        "https://172.16.20.115:8006/api2/json/nodes/${params.PROXMOX_NODE}/qemu/${vmId}?purge=1" \\
                                                        -w "%{http_code}" -o /tmp/vm_delete_${vmId}.json -s)
                                                    
                                                    if [ "\$TASK_RESULT" = "200" ]; then
                                                        echo "200"
                                                    elif [ "\$TASK_RESULT" = "404" ] || [ "\$TASK_RESULT" = "500" ]; then
                                                        # VM disappeared between check and delete - consider success
                                                        echo "404_ALREADY_GONE"
                                                    else
                                                        # Method 3: Last resort - try standard DELETE
                                                        FINAL_RESULT=\$(curl -k -X DELETE \\
                                                            -H "Authorization: PVEAPIToken=${PROXMOX_TOKEN_ID}=${PROXMOX_TOKEN_SECRET}" \\
                                                            "https://172.16.20.115:8006/api2/json/nodes/${params.PROXMOX_NODE}/qemu/${vmId}" \\
                                                            -w "%{http_code}" -o /tmp/vm_delete_final_${vmId}.json -s)
                                                        echo "\$FINAL_RESULT"
                                                    fi
                                                fi
                                            """,
                                            returnStdout: true
                                        ).trim()
                                        
                                        if (deleteResult == "200" || deleteResult == "404_ALREADY_GONE") {
                                            echo "✅ Successfully destroyed VM ${vmId}"
                                            destroyedVMs.add(vmId)
                                        } else {
                                            echo "❌ Failed to destroy VM ${vmId} (HTTP ${deleteResult})"
                                            sh "cat /tmp/vm_delete_${vmId}.json 2>/dev/null || cat /tmp/vm_delete_final_${vmId}.json 2>/dev/null || echo 'No response file available'"
                                            failedVMs.add(vmId)
                                        }
                                    } else {
                                        echo "⚠️ Unable to verify VM ${vmId} status (${checkResult}) - attempting destruction anyway..."
                                        
                                        // Attempt deletion despite check failure
                                        def deleteResult = sh(
                                            script: """
                                                curl -k -X DELETE \\
                                                    -H "Authorization: PVEAPIToken=${PROXMOX_TOKEN_ID}=${PROXMOX_TOKEN_SECRET}" \\
                                                    "https://172.16.20.115:8006/api2/json/nodes/${params.PROXMOX_NODE}/qemu/${vmId}?purge=1" \\
                                                    -w "%{http_code}" -o /tmp/vm_delete_fallback_${vmId}.json -s
                                            """,
                                            returnStdout: true
                                        ).trim()
                                        
                                        if (deleteResult == "200") {
                                            echo "✅ Successfully destroyed VM ${vmId}"
                                            destroyedVMs.add(vmId)
                                        } else if (deleteResult == "404" || deleteResult == "500") {
                                            echo "✅ VM ${vmId} not found - considering as already destroyed"
                                            destroyedVMs.add(vmId)
                                        } else {
                                            echo "❌ Failed to destroy VM ${vmId} (HTTP ${deleteResult})"
                                            sh "cat /tmp/vm_delete_fallback_${vmId}.json 2>/dev/null || echo 'No response file available'"
                                            failedVMs.add(vmId)
                                        }
                                    }
                                    
                                } catch (Exception e) {
                                    echo "Exception destroying VM ${vmId}: ${e.getMessage()}"
                                    failedVMs.add(vmId)
                                }
                            }
                        }
                        
                        // Summary
                        echo """
=== DIRECT VM DESTRUCTION SUMMARY ===
Total VMs requested: ${vmIds.size()}
Successfully destroyed/verified: ${destroyedVMs.size()} (${destroyedVMs.join(', ')})
Failed to destroy: ${failedVMs.size()} ${failedVMs.size() > 0 ? '(' + failedVMs.join(', ') + ')' : ''}

ℹ️  Note: VMs marked as 'successfully destroyed' include:
   - VMs that were actually destroyed (HTTP 200)
   - VMs that didn't exist (HTTP 404/500) - already destroyed
   - VMs that disappeared during destruction process
======================================
"""
                        
                        if (failedVMs.size() > 0) {
                            echo "⚠️ WARNING: ${failedVMs.size()} VMs failed to destroy directly."
                            echo "   Terraform destroy will attempt to clean up remaining resources."
                            echo "   Failed VMs: ${failedVMs.join(', ')}"
                        } else {
                            echo "✅ SUCCESS: All ${vmIds.size()} VMs destroyed/verified successfully!"
                            echo "   ${destroyedVMs.size()} VMs processed without errors"
                            echo "   Skipping terraform destroy stage as direct VM destruction completed"
                            // Set flag to skip terraform stage
                            env.SKIP_TERRAFORM_DESTROY = 'true'
                        }
                    }
                }
            }
        }
        
        stage('Terraform Destroy') {
            when {
                expression { return env.SKIP_TERRAFORM_DESTROY != 'true' }
            }
            steps {
                dir("${TERRAFORM_DIR}") {
                    withCredentials([
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-url", variable: 'TF_VAR_pm_api_url'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-id", variable: 'TF_VAR_pm_api_token_id'),
                        string(credentialsId: "${env.PROXMOX_CREDENTIALS_PREFIX}-api-token-secret", variable: 'TF_VAR_pm_api_token_secret')
                    ]) {
                        script {
                            def startTime = System.currentTimeMillis()
                            
                            echo "Starting infrastructure destruction for cluster: ${params.CLUSTER_NAME}"
                            
                            // Execute terraform destroy and handle exit codes properly
                            def destroyResult = sh(
                                script: '''#!/bin/bash
                                    set -o pipefail
                                    terraform destroy \
                                        -auto-approve \
                                        2>&1 | tee destroy.log
                                ''',
                                returnStatus: true
                            )
                            
                            def duration = ((System.currentTimeMillis() - startTime) / 1000).intValue()
                            
                            // Check destroy log content to understand what happened
                            def destroyLog = sh(
                                script: 'cat destroy.log 2>/dev/null || echo "No destroy log"',
                                returnStdout: true
                            ).trim()
                            
                            // Terraform exit codes:
                            // 0 = Success with changes
                            // 1 = Error occurred  
                            // 2 = Success but with warnings OR no changes needed
                            
                            if (destroyResult == 0) {
                                echo "✅ Infrastructure destroyed successfully in ${duration}s"
                                
                                // Clean up terraform files
                                sh '''
                                    rm -f terraform.tfstate terraform.tfstate.backup
                                    rm -f tfplan destroy.log
                                '''
                                
                            } else if (destroyResult == 2) {
                                // Check if it's "no changes" (resources already destroyed)
                                if (destroyLog.contains("No changes") || 
                                    destroyLog.contains("No objects need to be destroyed") ||
                                    destroyLog.contains("Resources: 0 destroyed")) {
                                    
                                    echo "✅ No infrastructure to destroy - resources already cleaned up in ${duration}s"
                                    echo "   This is normal when VMs were destroyed outside of Terraform"
                                    
                                    // Clean up terraform files
                                    sh '''
                                        rm -f terraform.tfstate terraform.tfstate.backup
                                        rm -f tfplan destroy.log
                                    '''
                                    
                                } else {
                                    echo "⚠️ Terraform destroy completed with warnings (exit code: ${destroyResult})"
                                    echo "   Duration: ${duration}s"
                                    sh 'cat destroy.log'
                                    
                                    // Still treat as success if no actual errors
                                    if (!destroyLog.contains("Error:") && !destroyLog.contains("error:")) {
                                        echo "✅ Treating as successful since no errors found in output"
                                    } else {
                                        error("Terraform destroy failed with errors")
                                    }
                                }
                                
                            } else {
                                echo "❌ Terraform destroy failed with exit code: ${destroyResult}"
                                echo "   Duration: ${duration}s"
                                
                                // Show destroy log for debugging
                                sh 'cat destroy.log'
                                
                                error("Failed to destroy infrastructure")
                            }
                        }
                    }
                }
            }
        }
        
        stage('Notify Django') {
            steps {
                script {
                    try {
                        echo "Notifying Django about cluster destruction..."
                        
                        // Send destruction notification to Django webhook using curl
                        sh """
                            echo "Sending destroy notification to Django..."
                            
                            WEBHOOK_URL="https://labngoprek.my.id/webhook/jenkins/"
                            PAYLOAD='{"name":"${JOB_NAME}","build":{"number":${BUILD_NUMBER},"status":"success","full_url":"${BUILD_URL}"},"action":"destroy","cluster_name":"${params.CLUSTER_NAME}"}'
                            
                            RESPONSE=\$(curl -s -w "%{http_code}" \\
                                -X POST \\
                                -H "Content-Type: application/json" \\
                                -d "\$PAYLOAD" \\
                                --connect-timeout 10 \\
                                --max-time 30 \\
                                "\$WEBHOOK_URL")
                            
                            HTTP_CODE=\$(echo "\$RESPONSE" | tail -c 4)
                            RESPONSE_BODY=\$(echo "\$RESPONSE" | sed 's/....\$//')
                            
                            if [ "\$HTTP_CODE" = "200" ]; then
                                echo "✅ Successfully notified Django about cluster destruction"
                                echo "Response: \$RESPONSE_BODY"
                            else
                                echo "⚠️ Django webhook returned HTTP \$HTTP_CODE"
                                echo "Response: \$RESPONSE_BODY"
                                echo "WARNING: Django may not know cluster was destroyed!"
                            fi
                        """
                        
                    } catch (Exception e) {
                        echo "Warning: Failed to notify Django about destruction: ${e.getMessage()}"
                        // Continue even if Django notification fails
                    }
                }
            }
        }
        
        stage('Notify Slack') {
            steps {
                script {
                    try {
                        withCredentials([string(credentialsId: env.SLACK_WEBHOOK_CREDENTIAL_ID, variable: 'SLACK_WEBHOOK_URL')]) {
                            def buildDuration = currentBuild.durationString.replace(' and counting', '')
                            
                            sh """
                                curl -X POST -H 'Content-type: application/json' \
                                --data '{
                                    "text": "*Cluster Destroyed*",
                                    "attachments": [
                                        {
                                            "color": "danger",
                                            "fields": [
                                                {
                                                    "title": "Cluster Name",
                                                    "value": "${params.CLUSTER_NAME}",
                                                    "short": true
                                                },
                                                {
                                                    "title": "Proxmox Node", 
                                                    "value": "${params.PROXMOX_NODE}",
                                                    "short": true
                                                },
                                                {
                                                    "title": "Duration",
                                                    "value": "${buildDuration}",
                                                    "short": true
                                                },
                                                {
                                                    "title": "Status",
                                                    "value": "Successfully Destroyed",
                                                    "short": true
                                                }
                                            ]
                                        }
                                    ]
                                }' \
                                "\${SLACK_WEBHOOK_URL}"
                            """
                        }
                    } catch (Exception e) {
                        echo "Warning: Failed to send Slack notification: ${e.getMessage()}"
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                // Archive destruction logs
                archiveArtifacts artifacts: "${TERRAFORM_DIR}/destroy.log", allowEmptyArchive: true
                
                def totalDuration = currentBuild.durationString.replace(' and counting', '')
                echo """
Destruction Summary
===================
Total Duration: ${totalDuration}
Cluster: ${params.CLUSTER_NAME}
"""
            }
        }
        
        success {
            script {
                def successMessage = """
==================== DESTRUCTION SUCCESS ====================
Cluster '${params.CLUSTER_NAME}' has been successfully destroyed!

What was destroyed:
- All VMs associated with cluster '${params.CLUSTER_NAME}'
- Network configurations
- Storage allocations
- Terraform state cleaned up

WARNING: All data has been permanently lost!

Next steps:
- Cluster is now completely removed from infrastructure
- You can create a new cluster with the same name if needed
- Django application has been notified of the destruction
===========================================================
"""
                echo successMessage
            }
        }
        
        failure {
            script {
                // Notify Django about destruction failure using curl
                try {
                    sh """
                        echo "Notifying Django about destruction failure..."
                        
                        WEBHOOK_URL="https://labngoprek.my.id/webhook/jenkins/"
                        PAYLOAD='{"name":"${JOB_NAME}","build":{"number":${BUILD_NUMBER},"status":"failure","full_url":"${BUILD_URL}"},"action":"destroy","cluster_name":"${params.CLUSTER_NAME}"}'
                        
                        RESPONSE=\$(curl -s -w "%{http_code}" \\
                            -X POST \\
                            -H "Content-Type: application/json" \\
                            -d "\$PAYLOAD" \\
                            --connect-timeout 10 \\
                            --max-time 30 \\
                            "\$WEBHOOK_URL")
                        
                        HTTP_CODE=\$(echo "\$RESPONSE" | tail -c 4)
                        echo "Django failure webhook response: HTTP \$HTTP_CODE"
                    """
                } catch (Exception e) {
                    echo "Warning: Failed to notify Django about failure: ${e.getMessage()}"
                }
                
                echo """
==================== DESTRUCTION FAILURE ====================
Failed to destroy cluster '${params.CLUSTER_NAME}'!

Common troubleshooting steps:
1. Check if VMs are still running in Proxmox
2. Verify terraform state consistency
3. Check network connectivity to Proxmox
4. Review destruction logs for specific errors
5. May need manual cleanup in Proxmox interface

IMPORTANT: Some resources may still exist and need manual cleanup!
=============================================================
"""
            }
        }
        
        cleanup {
            sh '''
                # Cleanup temporary files
                rm -f ${TERRAFORM_DIR}/destroy.log || true
                find . -name "*.retry" -delete || true
            '''
        }
    }
}